{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
 
  "logo": {
    "type": "builtin",
    "source": "arch",
    "width": 50,
    "height": 20,
    "padding": {
        "left": 5
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    {
        "type": "command",
        "key": "OS Age",
        "text": "install_date=$(stat -c %W / | xargs -I{} date -d @{} +%s 2>/dev/null); now=$(date +%s); days=$(( (now - install_date) / 86400 )); echo \"$days days\""
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    //"display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
  ]
}
